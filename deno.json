{
	"name": "@cartertemm/audiogame-utils",
	"version": "0.2.1",
	"license": "MIT",
	"publish": {
		"exclude": [
			".github",
			".gitignore",
			".superpowers",
			"tests",
			"examples",
			"docs",
			"dist",
			"node_modules",
			"index.html",
			"package.json",
			"package-lock.json",
			"tsconfig.json",
			"vitest.config.js"
		]
	},
	"imports": {
		"cacophony": "npm:cacophony@^0.18.3"
	},
	"compilerOptions": {
		"lib": [
			"dom",
			"dom.iterable",
			"deno.ns",
			"esnext"
		]
	},
	"exports": {
		".": "./src/index.js",
		"./input": "./src/input/index.js",
		"./speech": "./src/speech/index.js",
		"./audio": "./src/audio/index.js",
		"./audio/pool": "./src/audio/pool.js",
		"./audio/coords": "./src/audio/coords.js",
		"./audio/units": "./src/audio/units.js",
		"./net": "./src/net/index.js",
		"./net/server": "./src/net/server.js",
		"./net/testing": "./src/net/testing.js",
		"./storage": "./src/storage.js",
		"./platform": "./src/platform.js",
		"./events": "./src/events.js",
		"./ui": "./src/ui/index.js",
		"./focus": "./src/focus.js",
		"./rotation": "./src/rotation.js",
		"./math": "./src/math.js",
		"./map": "./src/map/index.js",
		"./physics": "./src/physics/index.js",
		"./clock": "./src/clock.js",
		"./stats": "./src/stats.js",
		"./text": "./src/text.js",
		"./runtime": "./src/runtime.js",
		"./tauri": "./src/tauri/index.js",
		"./window": "./src/window.js",
		"./create": "./bin/create.js"
	},
	"tasks": {
		"build": "deno task build:iife && deno task build:esm",
		"build:iife": "deno run -A npm:esbuild src/index.js --bundle --format=iife --global-name=audiogameUtils --minify --sourcemap --outfile=dist/audiogame-utils.min.js",
		"build:esm": "deno run -A npm:esbuild src/index.js --bundle --format=esm --minify --sourcemap --outfile=dist/audiogame-utils.esm.js",
		"examples": "echo Open http://localhost:3000 && deno run -A npm:serve . -l 3000",
		"example:net-chat": "deno run -A examples/net-chat-server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:deno": "deno run -A npm:vitest run",
		"test:types": "deno run -A npm:typescript/tsc --noEmit -p tsconfig.json",
		"check": "deno check src/index.d.ts src/runtime.d.ts src/window.d.ts src/tauri/index.d.ts tests/types.usage.ts tests/types.exports.ts tests/types.deno.ts"
	},
	"fmt": {
		"useTabs": true,
		"singleQuote": true
	}
}
