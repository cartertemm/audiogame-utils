{
	"name": "audiogame-utils",
	"version": "0.1.0",
	"description": "Building blocks for audiogames in the browser including accessible speech output, multi-finger gesture input, spatial sound, networking, UI management, menus, and more.",
	"type": "module",
	"license": "MIT",
	"types": "./types/index.d.ts",
	"files": [
		"src",
		"dist",
		"types",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.js"
		},
		"./input": {
			"types": "./types/input.d.ts",
			"default": "./src/input/index.js"
		},
		"./speech": {
			"types": "./types/speech.d.ts",
			"default": "./src/speech/index.js"
		},
		"./audio": {
			"types": "./types/audio.d.ts",
			"default": "./src/audio/index.js"
		},
		"./audio/pool": {
			"types": "./types/audio.d.ts",
			"default": "./src/audio/pool.js"
		},
		"./audio/coords": {
			"types": "./types/audio.d.ts",
			"default": "./src/audio/coords.js"
		},
		"./audio/units": {
			"types": "./types/audio.d.ts",
			"default": "./src/audio/units.js"
		},
		"./net": {
			"types": "./types/net.d.ts",
			"default": "./src/net/index.js"
		},
		"./storage": {
			"types": "./types/storage.d.ts",
			"default": "./src/storage.js"
		},
		"./platform": {
			"types": "./types/platform.d.ts",
			"default": "./src/platform.js"
		},
		"./events": {
			"types": "./types/events.d.ts",
			"default": "./src/events.js"
		},
		"./ui": {
			"types": "./types/ui.d.ts",
			"default": "./src/ui/index.js"
		},
		"./focus": {
			"types": "./types/focus.d.ts",
			"default": "./src/focus.js"
		},
		"./rotation": {
			"types": "./types/rotation.d.ts",
			"default": "./src/rotation.js"
		},
		"./math": {
			"types": "./types/math.d.ts",
			"default": "./src/math.js"
		},
		"./map": {
			"types": "./types/map.d.ts",
			"default": "./src/map/index.js"
		},
		"./physics": {
			"types": "./types/physics.d.ts",
			"default": "./src/physics/index.js"
		}
	},
	"scripts": {
		"build": "npm run build:iife && npm run build:esm",
		"build:iife": "esbuild src/index.js --bundle --format=iife --global-name=audiogameUtils --minify --sourcemap --outfile=dist/audiogame-utils.min.js",
		"build:esm": "esbuild src/index.js --bundle --format=esm --minify --sourcemap --outfile=dist/audiogame-utils.esm.js",
		"examples": "echo Open http://localhost:3000 && npx --yes serve . -l 3000",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"cacophony": "^0.18.3"
	},
	"devDependencies": {
		"esbuild": "^0.21.5",
		"happy-dom": "^13.0.0",
		"vitest": "^1.0.0"
	}
}
